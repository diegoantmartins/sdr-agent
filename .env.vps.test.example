# =====================================================
# SDR AGENT - ENV DE HOMOLOGAÇÃO (VPS / TESTE)
# Domínio painel: sdr-synapasea.sentiia.com.br
# =====================================================

# ========== SERVER ==========
PORT=3000
NODE_ENV=test
LOG_LEVEL=debug

# ========== DATABASE (SUPABASE/POSTGRES) ==========
# Exemplo Supabase (pooler):
# DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agent"

# ========== MONGODB (AGENDA/JOBS) ==========
# Se usar Mongo com authSource=admin:
MONGODB_URL="mongodb://root:mongodb_password@127.0.0.1:27018/agent-agenda?authSource=admin"

# ========== REDIS ==========
REDIS_URL="redis://127.0.0.1:6379"

# ========== OPENAI ==========
OPENAI_API_KEY="sk-proj-xxxxxxxx"
OPENAI_MODEL="gpt-5-nano"

# ========== CHATWOOT ==========
CHATWOOT_URL="https://connect.synapsea.com.br"
CHATWOOT_API_TOKEN="COLE_SEU_TOKEN_AQUI"
CHATWOOT_ACCOUNT_ID="1"

# ========== UAZAPI ==========
UAZAPI_URL="https://api.uazapi.com"
UAZAPI_KEY="COLE_SUA_CHAVE_UAZAPI_AQUI"

# ========== WEBHOOK SECRETS (RECOMENDADO) ==========
UAZAPI_WEBHOOK_SECRET="troque-por-segredo-forte"
CHATWOOT_WEBHOOK_SECRET="troque-por-segredo-forte"

# ========== AGENT RUNTIME CONFIG ==========
AGENT_AUTO_REPLY_ENABLED=true
AGENT_COMPANY_NAME="Synapsea"
AGENT_OBJECTIVE="Qualificar leads e avançar para reunião ou proposta." 
AGENT_TONE="consultivo e cordial"
AGENT_LANGUAGE="português do Brasil"
AGENT_MAX_REPLY_CHARS=420

# Arquivo persistido pelo painel admin (runtime)
AGENT_CONFIG_PATH="./data/agent-config.json"

# ========== ADMIN PANEL SECURITY ==========
# Gere com: openssl rand -hex 32
ADMIN_CONFIG_TOKEN="GERAR_TOKEN_FORTE"

# ========== OPTIONAL ==========
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
FOLLOW_UP_DELAY_HOURS=24
COLD_STORAGE_DAYS=7
MIN_INTENT_SCORE=0.7
